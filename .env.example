# OpenRouter — required for extraction
OPENROUTER_API_KEY=

# Model routing. OpenRouter takes an ordered failover list.
INVOICE_MODEL_PRIMARY=openai/gpt-4.1
INVOICE_MODEL_FALLBACK=openai/gpt-4.1-mini

# Input limits. Chosen to bound cost and latency, not to match a provider ceiling.
INVOICE_MAX_UPLOAD_BYTES=26214400
INVOICE_MAX_PDF_PAGES=20
INVOICE_RASTER_DPI=150
