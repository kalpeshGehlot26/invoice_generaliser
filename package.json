{
  "name": "ifg-control-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "report": "npm run report --workspace @ifg/control-engine",
    "gen:samples": "python3 scripts/gen-samples.py",
    "fixture": "google-chrome --headless=new --disable-gpu --no-sandbox --hide-scrollbars --window-size=794,1123 --screenshot=fixtures/invoice-de-assigned.png file://$PWD/fixtures/invoice-de-assigned.html",
    "e2e": "node scripts/e2e-screenshot.mjs fixtures/invoice-de-assigned.png"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "puppeteer-core": "^25.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
